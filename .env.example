# SEVA MAINTENANCE MANAGEMENT SYSTEM ENVIRONMENT CONFIGURATION

# Application Port
APP_PORT=8080

# Environment (development | production | test)
NODE_ENV=production

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=seva
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password_min_16_chars
POSTGRES_DB=seva_maintenance
DATABASE_URL=postgresql://seva:change_this_to_a_secure_postgres_password_min_16_chars@db:5432/seva_maintenance?schema=public

# Session Secret (min 32 characters, cryptographically random)
SESSION_SECRET=change_this_to_a_random_32_character_string_for_session_encryption

# HTTPS / Cookies: Set to true when running behind HTTPS/TLS, false for plain HTTP LAN
COOKIE_SECURE=false

# Local Storage Directory for Uploads (Bind-mounted to ./data/uploads in container)
UPLOAD_DIR=/app/data/uploads

# Timezone (defaults to Australia/Adelaide as specified)
TZ=Australia/Adelaide

# Initial System Administrator Account (Forced password change on first login)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@seva.local
ADMIN_PASSWORD=AdminSeva2026!ChangeMe

# Demo Data Seeder (Set true to populate demo tree, recurring tasks, members, etc.)
SEED_DEMO=true

# Optional SMTP Email Configuration (If not configured, in-app notifications only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Seva System <no-reply@seva.local>"
SMTP_SECURE=false

# Caddy HTTPS Domain (Optional: if set, Caddy issues free Let's Encrypt certificate; otherwise tls internal)
DOMAIN=

# Logging level (debug | info | warn | error)
LOG_LEVEL=info

# Disable Next.js Telemetry (mandatory zero-external-calls constraint)
NEXT_TELEMETRY_DISABLED=1
