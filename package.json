{
  "name": "seva-maintenance",
  "version": "1.0.0",
  "private": true,
  "description": "Seva Maintenance Management System - Self-hosted, production-ready maintenance platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker && npm run build:seed && npm run build:reset-password",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/worker/index.js",
    "build:seed": "esbuild prisma/seed.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/seed.js",
    "build:reset-password": "esbuild scripts/reset-password.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/reset-password.js",
    "start": "next start",
    "worker": "node dist/worker/index.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "new:module": "tsx scripts/new-module.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "reset-admin": "tsx scripts/reset-password.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.66.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "file-type": "^19.6.0",
    "lucide-react": "^0.475.0",
    "next": "15.1.7",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.16.0",
    "pino": "^9.6.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "sharp": "^0.33.5",
    "unzipper": "^0.12.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.19",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/unzipper": "^0.10.11",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.1.7",
    "fast-check": "^3.23.2",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
